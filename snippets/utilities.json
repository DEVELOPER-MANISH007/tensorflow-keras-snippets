    "Load model weights": {
        "prefix": "util_loadweights",
        "body": [
            "model.load_weights(\"$1.weights.h5\")"
        ],
        "description": "Load previously saved model weights"
    },
    "Convert model to TFLite": {
        "prefix": "util_tfliteconvert",
        "body": [
            "converter = tf.lite.TFLiteConverter.from_keras_model(model)",
            "tflite_model = converter.convert()",
            "",
            "with open(\"$1.tflite\", \"wb\") as file:",
            "    file.write(tflite_model)"
        ],
        "description": "Convert a Keras model to TensorFlow Lite"
    },
    "Print model summary": {
        "prefix": "util_modelsummary",
        "body": [
            "model.summary()"
        ],
        "description": "Display the model architecture and parameter counts"
    },
    "Plot model architecture": {
        "prefix": "util_plotmodel",
        "body": [
            "keras.utils.plot_model(",
            "    model,",
            "    to_file=\"$1.png\",",
            "    show_shapes=True,",
            "    show_layer_names=True",
            ")"
        ],
        "description": "Export a visual diagram of the Keras model"
    },
    "Mixed precision policy": {
        "prefix": "util_mixedprecision",
        "body": [
            "keras.mixed_precision.set_global_policy(\"$1\")"
        ],
        "description": "Enable a mixed-precision policy such as mixed_float16"
    },
    "Gradient clipping optimizer": {
        "prefix": "util_gradientclip",
        "body": [
            "optimizer = keras.optimizers.Adam(",
            "    learning_rate=$1,",
            "    clipnorm=$2",
            ")"
        ],
        "description": "Configure gradient clipping by global norm on an optimizer"
    },
    "GradientTape custom step": {
        "prefix": "util_gradienttape",
        "body": [
            "with tf.GradientTape() as tape:",
            "    predictions = model($1, training=True)",
            "    loss = loss_fn($2, predictions)",
            "",
            "gradients = tape.gradient(loss, model.trainable_variables)",
            "optimizer.apply_gradients(zip(gradients, model.trainable_variables))"
        ],
        "description": "Calculate and apply gradients using GradientTape"
    },
    "Gradient accumulation note": {
        "prefix": "util_gradaccum",
        "body": [
            "# Gradient accumulation requires a custom training loop.",
            "# Accumulate gradients over $1 micro-batches before applying an update.",
            "accumulation_steps = $1",
            "gradient_accumulators = [",
            "    tf.Variable(tf.zeros_like(variable), trainable=False)",
            "    for variable in model.trainable_variables",
            "]"
        ],
        "description": "Set up gradient accumulator variables for a custom training loop"
    },
    "Class weights": {
        "prefix": "util_classweights",
        "body": [
            "from sklearn.utils.class_weight import compute_class_weight",
            "import numpy as np",
            "",
            "classes = np.unique($1)",
            "weights = compute_class_weight(",
            "    class_weight=\"balanced\",",
            "    classes=classes,",
            "    y=$1",
            ")",
            "class_weights = dict(zip(classes, weights))"
        ],
        "description": "Calculate balanced class weights for imbalanced classification"
    },
    "Sample weights fit": {
        "prefix": "util_sampleweights",
        "body": [
            "history = model.fit(",
            "    $1,",
            "    $2,",
            "    sample_weight=$3,",
            "    epochs=$4,",
            "    batch_size=$5",
            ")"
        ],
        "description": "Train a model using per-sample weights"
    },
    "Set random seeds": {
        "prefix": "util_seedsetup",
        "body": [
            "import random",
            "import numpy as np",
            "import tensorflow as tf",
            "",
            "seed = $1",
            "random.seed(seed)",
            "np.random.seed(seed)",
            "tf.keras.utils.set_random_seed(seed)"
        ],
        "description": "Set Python, NumPy and TensorFlow random seeds"
    },
    "Dataset shuffle": {
        "prefix": "util_datasetshuffle",
        "body": [
            "dataset = dataset.shuffle(",
            "    buffer_size=$1,",
            "    seed=$2,",
            "    reshuffle_each_iteration=True",
            ")"
        ],
        "description": "Shuffle a tf.data dataset"
    },
    "Dataset batch": {
        "prefix": "util_datasetbatch",
        "body": [
            "dataset = dataset.batch($1)"
        ],
        "description": "Batch a tf.data dataset"
    },
    "Dataset cache": {
        "prefix": "util_datasetcache",
        "body": [
            "dataset = dataset.cache()"
        ],
        "description": "Cache a dataset in memory"
    },
    "Dataset prefetch": {
        "prefix": "util_datasetprefetch",
        "body": [
            "dataset = dataset.prefetch(tf.data.AUTOTUNE)"
        ],
        "description": "Prefetch batches to overlap input processing and model execution"
    },
    "Dataset map": {
        "prefix": "util_datasetmap",
        "body": [
            "dataset = dataset.map(",
            "    $1,",
            "    num_parallel_calls=tf.data.AUTOTUNE",
            ")"
        ],
        "description": "Map a preprocessing function over a dataset in parallel"
    },
    "Dataset repeat": {
        "prefix": "util_datasetrepeat",
        "body": [
            "dataset = dataset.repeat($1)"
        ],
        "description": "Repeat a dataset a specified number of times"
    },
    "Dataset parallel pipeline": {
        "prefix": "util_datasetparallel",
        "body": [
            "dataset = (",
            "    dataset",
            "    .map($1, num_parallel_calls=tf.data.AUTOTUNE)",
            "    .batch($2)",
            "    .prefetch(tf.data.AUTOTUNE)",
            ")"
        ],
        "description": "Build a parallel tf.data preprocessing, batching and prefetch pipeline"
    },
    "Dataset zip": {
        "prefix": "util_datasetzip",
        "body": [
            "dataset = tf.data.Dataset.zip(($1, $2))"
        ],
        "description": "Zip two datasets together"
    }
}
