{
  "Custom TensorFlow training step": {
    "prefix": "tf-gradient-tape",
    "body": [
      "optimizer = tf.keras.optimizers.Adam(${1:1e-3})",
      "for features, labels in ${2:train_ds}.take(${3:1}):",
      "    with tf.GradientTape() as tape:",
      "        predictions = ${4:model}(features, training=True)",
      "        loss = loss_fn(labels, predictions)",
      "    gradients = tape.gradient(loss, ${4:model}.trainable_variables)",
      "    optimizer.apply_gradients(zip(gradients, ${4:model}.trainable_variables))",
      "$0"
    ],
    "description": "Apply one custom TensorFlow gradient update using a GradientTape"
  },
  "Custom loss function": {
    "prefix": "keras-custom-loss",
    "body": [
      "def ${1:custom_loss}(y_true, y_pred):",
      "    error = y_true - y_pred",
      "    return tf.reduce_mean(tf.square(error), axis=-1)",
      "$0"
    ],
    "description": "Define a per-example custom regression loss"
  },
  "Custom metric class": {
    "prefix": "keras-custom-metric",
    "body": [
      "class ${1:MeanPrediction}(tf.keras.metrics.Metric):",
      "    def __init__(self, name=\"mean_prediction\", **kwargs):",
      "        super().__init__(name=name, **kwargs)",
      "        self.total = self.add_weight(name=\"total\", initializer=\"zeros\")",
      "        self.count = self.add_weight(name=\"count\", initializer=\"zeros\")",
      "",
      "    def update_state(self, y_true, y_pred, sample_weight=None):",
      "        values = tf.cast(y_pred, self.dtype)",
      "        if sample_weight is None:",
      "            weights = tf.ones_like(values)",
      "        else:",
      "            weights = tf.cast(sample_weight, self.dtype)",
      "            if weights.shape.rank is not None and values.shape.rank is not None:",
      "                while weights.shape.rank < values.shape.rank:",
      "                    weights = tf.expand_dims(weights, axis=-1)",
      "            weights = tf.broadcast_to(weights, tf.shape(values))",
      "        self.total.assign_add(tf.reduce_sum(values * weights))",
      "        self.count.assign_add(tf.reduce_sum(weights))",
      "",
      "    def result(self):",
      "        return tf.math.divide_no_nan(self.total, self.count)",
      "",
      "    def reset_state(self):",
      "        self.total.assign(0.0)",
      "        self.count.assign(0.0)",
      "$0"
    ],
    "description": "Implement a stateful Keras metric with update, result, and reset methods"
  },
  "Custom Keras layer": {
    "prefix": "keras-custom-layer",
    "body": [
      "class ${1:ScaleLayer}(tf.keras.layers.Layer):",
      "    def __init__(self, scale=${2:1.0}, **kwargs):",
      "        super().__init__(**kwargs)",
      "        self.scale = scale",
      "",
      "    def call(self, inputs):",
      "        return inputs * self.scale",
      "",
      "    def get_config(self):",
      "        return {**super().get_config(), \"scale\": self.scale}",
      "$0"
    ],
    "description": "Create a serializable custom layer with a configurable scalar"
  },
  "Subclassed Keras model": {
    "prefix": "keras-subclass-model",
    "body": [
      "class ${1:MLP}(tf.keras.Model):",
      "    def __init__(self, units=${2:64}, **kwargs):",
      "        super().__init__(**kwargs)",
      "        self.hidden = tf.keras.layers.Dense(units, activation=\"relu\")",
      "        self.output_layer = tf.keras.layers.Dense(${3:1})",
      "",
      "    def call(self, inputs, training=False):",
      "        x = self.hidden(inputs)",
      "        return self.output_layer(x)",
      "$0"
    ],
    "description": "Define a model subclass with layers created in the constructor"
  },
  "Custom callback": {
    "prefix": "keras-custom-callback",
    "body": [
      "class ${1:LearningRateLogger}(tf.keras.callbacks.Callback):",
      "    def on_epoch_end(self, epoch, logs=None):",
      "        learning_rate = self.model.optimizer.learning_rate",
      "        print(f\"epoch={epoch + 1}, learning_rate={float(learning_rate.numpy()):.6g}\")",
      "$0"
    ],
    "description": "Create a callback that reports the optimizer learning rate after each epoch"
  },
  "Override Keras train step": {
    "prefix": "keras-custom-train-step",
    "body": [
      "class ${1:CustomModel}(tf.keras.Model):",
      "    def train_step(self, data):",
      "        if len(data) == 3:",
      "            x, y, sample_weight = data",
      "        else:",
      "            x, y = data",
      "            sample_weight = None",
      "        with tf.GradientTape() as tape:",
      "            y_pred = self(x, training=True)",
      "            loss = self.compute_loss(y=y, y_pred=y_pred, sample_weight=sample_weight)",
      "        gradients = tape.gradient(loss, self.trainable_variables)",
      "        self.optimizer.apply_gradients(zip(gradients, self.trainable_variables))",
      "        for metric in self.metrics:",
      "            if metric.name == \"loss\":",
      "                metric.update_state(loss)",
      "            else:",
      "                metric.update_state(y, y_pred, sample_weight=sample_weight)",
      "        return {metric.name: metric.result() for metric in self.metrics}",
      "$0"
    ],
    "description": "Customize a Keras train_step while retaining model.fit and compiled metrics"
  },
