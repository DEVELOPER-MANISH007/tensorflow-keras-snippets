  "Measure tf.data input wait time": {
    "prefix": "tf-data-benchmark",
    "body": [
      "from time import perf_counter",
      "# Use a dataset with enough batches; this measures iterator wait time, not model throughput.",
      "for _ in ${1:dataset}.take(${2:2}):  # Warm-up",
      "    pass",
      "started = perf_counter()",
      "batch_count = 0",
      "for _ in ${1:dataset}.take(${3:50}):",
      "    batch_count += 1",
      "elapsed = perf_counter() - started",
      "print(f\"{batch_count} batches in {elapsed:.2f}s ({elapsed / max(batch_count, 1):.4f}s/batch)\")",
      "$0"
    ],
    "description": "Roughly measure input iterator wait time after warm-up to help identify a slow tf.data pipeline"
  }
