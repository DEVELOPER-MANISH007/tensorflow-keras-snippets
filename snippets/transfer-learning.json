{
  "Load MobileNetV2 backbone": {"prefix": "tl-mobilenetv2", "body": ["base_model = tf.keras.applications.MobileNetV2(", "    input_shape=(${1:224}, ${2:224}, 3),", "    include_top=False,", "    weights=\"imagenet\",", ")", "base_model.trainable = False", "$0"], "description": "Load and freeze an ImageNet MobileNetV2 feature extractor"},
  "MobileNetV2 preprocessing": {"prefix": "tl-mobilenetv2-preprocess", "body": ["preprocess = tf.keras.applications.mobilenet_v2.preprocess_input", "images = preprocess(${1:images})  # Expects pixel values in the 0-255 range.", "$0"], "description": "Apply MobileNetV2-specific preprocessing to raw image pixel values"},
  "Transfer learning classification head": {"prefix": "tl-classification-head", "body": ["# Run tl-image-data first to define class_names; the MobileNetV2 input size must match the backbone.", "num_classes = len(class_names)", "inputs = tf.keras.Input(shape=(${1:224}, ${2:224}, 3))", "x = tf.keras.applications.mobilenet_v2.preprocess_input(inputs)", "x = ${3:base_model}(x, training=False)", "x = tf.keras.layers.GlobalAveragePooling2D()(x)", "x = tf.keras.layers.Dropout(${4:0.2})(x)", "outputs = tf.keras.layers.Dense(num_classes, activation=\"softmax\")(x)", "model = tf.keras.Model(inputs, outputs)", "$0"], "description": "Attach a multiclass head after loading class_names and a matching MobileNetV2 backbone"},
  "Fine-tune pretrained backbone": {"prefix": "tl-finetune", "body": ["base_model.trainable = True", "for layer in base_model.layers[:-${1:20}]:", "    layer.trainable = False", "# Recompile after changing trainable variables; retain training=False for the base call.", "model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=${2:1e-5}), loss=tf.keras.losses.SparseCategoricalCrossentropy(), metrics=[\"accuracy\"])", "history = model.fit(${3:train_ds}, validation_data=${4:val_ds}, epochs=${5:10})", "$0"], "description": "Unfreeze only top backbone layers, then recompile with sparse categorical loss and a low learning rate"},
  "Two-phase transfer learning": {"prefix": "tl-two-phase", "body": ["base_model.trainable = False", "model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=${1:1e-3}), loss=tf.keras.losses.SparseCategoricalCrossentropy(), metrics=[\"accuracy\"])", "head_history = model.fit(${2:train_ds}, validation_data=${3:val_ds}, epochs=${4:10})", "base_model.trainable = True", "for layer in base_model.layers[:-${5:20}]:", "    layer.trainable = False", "# Recompile after changing trainable variables; keep the base call in inference mode for BatchNorm.", "model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=${6:1e-5}), loss=tf.keras.losses.SparseCategoricalCrossentropy(), metrics=[\"accuracy\"])", "fine_tune_history = model.fit(${2:train_ds}, validation_data=${3:val_ds}, epochs=${7:10})", "$0"], "description": "Train a frozen-backbone head, then fine-tune only top layers with a low learning rate"},
  "Load train validation test image folders": {"prefix": "tl-image-data", "body": ["# Expected layout: data/{train,validation,test}/<class_name>/<image files>.", "image_size = (${1:224}, ${2:224})", "batch_size = ${3:32}", "train_ds = tf.keras.utils.image_dataset_from_directory(", "    ${4:\"data/train\"}, image_size=image_size, batch_size=batch_size,", "    label_mode=\"int\", shuffle=True, seed=${5:42}", ")", "class_names = train_ds.class_names", "val_ds = tf.keras.utils.image_dataset_from_directory(", "    ${6:\"data/validation\"}, class_names=class_names, image_size=image_size,", "    batch_size=batch_size, label_mode=\"int\", shuffle=False", ")", "test_ds = tf.keras.utils.image_dataset_from_directory(", "    ${7:\"data/test\"}, class_names=class_names, image_size=image_size,", "    batch_size=batch_size, label_mode=\"int\", shuffle=False", ")", "train_ds = train_ds.prefetch(tf.data.AUTOTUNE)", "val_ds = val_ds.prefetch(tf.data.AUTOTUNE)", "test_ds = test_ds.prefetch(tf.data.AUTOTUNE)", "$0"], "description": "Load explicitly separated class-folder image splits with shared class order and integer labels"},
  "Train transfer learning classification head": {"prefix": "tl-train-head", "body": ["# Run tl-image-data, tl-mobilenetv2, and tl-classification-head first.", "model.compile(", "    optimizer=tf.keras.optimizers.Adam(learning_rate=${1:1e-3}),", "    loss=tf.keras.losses.SparseCategoricalCrossentropy(),", "    metrics=[\"accuracy\"],", ")", "early_stopping = tf.keras.callbacks.EarlyStopping(monitor=\"val_loss\", patience=${2:3}, restore_best_weights=True)", "head_history = model.fit(train_ds, validation_data=val_ds, epochs=${3:10}, callbacks=[early_stopping])", "$0"], "description": "Compile for integer class labels and train a frozen MobileNetV2 classification head"},
  "Evaluate save reload and predict transfer model": {"prefix": "tl-evaluate-save-predict", "body": ["from pathlib import Path", "", "test_metrics = model.evaluate(test_ds, return_dict=True)", "print(test_metrics)", "save_path = Path(${1:\"artifacts/mobilenetv2_classifier.keras\"})", "save_path.parent.mkdir(parents=True, exist_ok=True)", "model.save(save_path)", "restored_model = tf.keras.models.load_model(save_path)", "images, labels = next(iter(test_ds.take(1)))", "scores = restored_model.predict(images[:1], verbose=0)[0]", "predicted_id = int(tf.argmax(scores).numpy())", "print(\"actual:\", class_names[int(labels[0].numpy())], \"predicted:\", class_names[predicted_id])", "$0"], "description": "Evaluate once on held-out images, save and reload the .keras model, then predict one example"}
}
